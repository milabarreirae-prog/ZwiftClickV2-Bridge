    <Description>Conecta tu mando de ciclismo indoor con cualquier app, mediante teclas. Software libre, gratis y para siempre.</Description>
    <Company>Hecho con cariño por una mujer trans</Company>
    <Authors>Una mujer trans 🏳️‍⚧️</Authors>
    <Copyright>Software libre (MIT). Gratis y para siempre.</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reutiliza TODA la lógica probada del bridge (BLE, cripto, unlock, teclado). -->
