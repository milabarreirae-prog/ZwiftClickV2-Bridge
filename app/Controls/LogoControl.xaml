<UserControl x:Class="Violeta.Controls.LogoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <!-- Logotipo: una ciclista con una flor en la cabeza. Todo vectorial → nítido a cualquier tamaño. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="220" Height="170">

            <!-- Ruedas -->
            <Ellipse Canvas.Left="22" Canvas.Top="90" Width="60" Height="60"
                     Stroke="{StaticResource LilacBrush}" StrokeThickness="7" Fill="Transparent" />
            <Ellipse Canvas.Left="138" Canvas.Top="90" Width="60" Height="60"
                     Stroke="{StaticResource LilacBrush}" StrokeThickness="7" Fill="Transparent" />
            <Ellipse Canvas.Left="48" Canvas.Top="116" Width="8" Height="8" Fill="{StaticResource LilacBrush}" />
            <Ellipse Canvas.Left="164" Canvas.Top="116" Width="8" Height="8" Fill="{StaticResource LilacBrush}" />

            <!-- Cuadro de la bici -->
            <Path Stroke="{StaticResource PrimaryBrush}" StrokeThickness="7"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M52,120 L95,120 L88,72 Z M95,120 L150,74 M88,72 L150,74 M150,74 L168,120" />

            <!-- Manillar y sillín -->
            <Path Stroke="{StaticResource PrimaryBrush}" StrokeThickness="6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M150,74 C157,66 168,66 173,72" />
            <Path Stroke="{StaticResource PrimaryBrush}" StrokeThickness="7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M80,71 L97,71" />

            <!-- Piernas -->
            <Path Stroke="{StaticResource LilacBrush}" StrokeThickness="8"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M92,70 L104,98 L95,120" />

            <!-- Cabello al viento (lila) -->
            <Path Stroke="{StaticResource LilacBrush}" StrokeThickness="6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                  Data="M139,33 C152,33 156,47 148,58" />
            <Path Stroke="{StaticResource LilacBrush}" StrokeThickness="5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                  Data="M141,30 C156,30 162,46 152,62" />

            <!-- Torso (top rosa) y brazo -->
            <Path Stroke="{StaticResource BloomBrush}" StrokeThickness="10"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M92,70 L128,52" />
            <Path Stroke="{StaticResource BloomBrush}" StrokeThickness="7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M128,52 L150,74" />

            <!-- Cabeza -->
            <Ellipse Canvas.Left="129" Canvas.Top="29" Width="22" Height="22" Fill="#F3C9AE" />

            <!-- Flor en la cabeza (5 pétalos + centro) -->
            <Ellipse Canvas.Left="125.5" Canvas.Top="14"   Width="9" Height="9" Fill="{StaticResource PetalBrush}" />
            <Ellipse Canvas.Left="132.5" Canvas.Top="18"   Width="9" Height="9" Fill="{StaticResource BloomBrush}" />
            <Ellipse Canvas.Left="130.5" Canvas.Top="26"   Width="9" Height="9" Fill="{StaticResource PetalBrush}" />
            <Ellipse Canvas.Left="120.5" Canvas.Top="26"   Width="9" Height="9" Fill="{StaticResource BloomBrush}" />
            <Ellipse Canvas.Left="118.5" Canvas.Top="18"   Width="9" Height="9" Fill="{StaticResource PetalBrush}" />
            <Ellipse Canvas.Left="126.5" Canvas.Top="21.5" Width="6" Height="6" Fill="{StaticResource PollenBrush}" />

        </Canvas>
    </Viewbox>
</UserControl>
