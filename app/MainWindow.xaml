<Window x:Class="Violeta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Violeta.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Violeta" Height="760" Width="1140"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="#160E22">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <!-- ══ Fondo aurora (capa más profunda) ══ -->
        <c:AuroraBackground />

        <!-- ══ Estructura ══ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />   <!-- barra de título -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── Barra de título a medida ── -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <c:LogoControl Width="26" Height="20" />
                    <TextBlock Text="Violeta" Foreground="{StaticResource LilacSoftBrush}" FontWeight="SemiBold"
                               FontSize="13" VerticalAlignment="Center" Margin="9,0,0,0" />
                    <TextBlock Text="ciclismo indoor, libre" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11.5" VerticalAlignment="Center" Margin="10,1,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="btnMin" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Min_Click" />
                    <Button x:Name="btnMax" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Max_Click" />
                    <Button x:Name="btnClose" Style="{StaticResource CaptionButtonClose}" Content="&#xE8BB;" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- ── Cuerpo: barra lateral + contenido ── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Barra lateral de vidrio -->
                <Border Grid.Column="0" Margin="14,2,7,14" CornerRadius="22"
                        Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassStroke}"
                        BorderThickness="1" Effect="{StaticResource SoftShadow}">
                    <DockPanel Margin="16,20,16,18">

                        <!-- Marca -->
                        <StackPanel DockPanel.Dock="Top" Margin="4,0,0,22">
                            <c:LogoControl Width="56" Height="44" HorizontalAlignment="Left" />
                            <TextBlock Text="Violeta" Foreground="White" FontSize="23" FontWeight="Bold" Margin="0,10,0,0" />
                            <TextBlock Text="tu mando, libre" Style="{StaticResource Muted}" FontSize="11.5" />
                        </StackPanel>

                        <!-- Pie -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Style="{StaticResource FreeBadge}" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="SemiBold"
                                               Margin="7,0,0,0" Text="Gratis y para siempre" />
                                </StackPanel>
                            </Border>
                            <Border Height="5" CornerRadius="3" Background="{StaticResource TransRibbonGradient}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Margin="2,9,0,0"
                                       Text="Hecha con cariño por una mujer trans 🏳️‍⚧️" />
                        </StackPanel>

                        <!-- Navegación con indicador deslizante -->
                        <Grid DockPanel.Dock="Top" Margin="0,4,0,0">
                            <Border x:Name="navIndicator" Height="46" VerticalAlignment="Top"
                                    CornerRadius="13" Background="{StaticResource SurfaceHiBrush}"
                                    BorderBrush="{StaticResource GlassStrokeSoft}" BorderThickness="1">
                                <Border.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="18" ShadowDepth="0" Opacity="0.35" /></Border.Effect>
                            </Border>
                            <Border x:Name="navAccent" Width="3.5" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="0,12,0,0" CornerRadius="2" Background="{StaticResource PrimaryGradient}" />
                            <StackPanel x:Name="navStack">
                                <Button x:Name="btnHome"     Style="{StaticResource NavButton}" Click="Nav_Click" Content="🏠   Inicio" />
                                <Button x:Name="btnTutorial" Style="{StaticResource NavButton}" Click="Nav_Click" Content="📖   Cómo funciona" />
                                <Button x:Name="btnConnect"  Style="{StaticResource NavButton}" Click="Nav_Click" Content="🚴   Conectar mando" />
                                <Button x:Name="btnAbout"    Style="{StaticResource NavButton}" Click="Nav_Click" Content="💜   Acerca de" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Contenido (con transición de entrada) -->
                <ContentControl x:Name="Host" Grid.Column="1" Margin="7,2,8,8">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="hostShift" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
