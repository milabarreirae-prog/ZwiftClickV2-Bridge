<Window x:Class="Violeta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Violeta.Controls"
        Title="Violeta" Height="730" Width="1060"
        MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="262" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══ Barra lateral ══ -->
        <Border Grid.Column="0" Background="{StaticResource BgDeepBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,22,18,18">

                <!-- Marca -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,26">
                    <c:LogoControl Width="48" Height="38" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Violeta" Foreground="White" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="ciclismo indoor, libre" Style="{StaticResource Muted}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>

                <!-- Pie de la barra: insignia gratis + cinta -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource FreeBadge}" Margin="0,0,0,12">
                        <TextBlock Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="SemiBold"
                                   Text="● Gratis y para siempre" />
                    </Border>
                    <Border Height="5" CornerRadius="3" Background="{StaticResource TransRibbonGradient}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="2,8,0,0"
                               Text="Hecha con cariño por una mujer trans 🏳️‍⚧️" />
                </StackPanel>

                <!-- Navegación -->
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="btnHome"     Style="{StaticResource NavButton}" Click="Nav_Click" Content="🏠   Inicio" />
                    <Button x:Name="btnTutorial" Style="{StaticResource NavButton}" Click="Nav_Click" Content="📖   Cómo funciona" />
                    <Button x:Name="btnConnect"  Style="{StaticResource NavButton}" Click="Nav_Click" Content="🚴   Conectar mando" />
                    <Button x:Name="btnAbout"    Style="{StaticResource NavButton}" Click="Nav_Click" Content="💜   Acerca de" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ Contenido ══ -->
        <ContentControl x:Name="Host" Grid.Column="1" />
    </Grid>
</Window>
