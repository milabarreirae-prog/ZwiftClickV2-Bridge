<UserControl x:Class="Violeta.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Violeta.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="34,26,30,34" MaxWidth="1000" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Saludo -->
            <StackPanel Grid.Row="0" Margin="4,0,0,16">
                <TextBlock Style="{StaticResource Muted}" Text="Bienvenida de vuelta" />
                <TextBlock Style="{StaticResource Display}" FontSize="31" Text="Tu mando, listo para rodar." />
            </StackPanel>

            <!-- Héroe: estado + mando en vivo -->
            <Border Grid.Row="1" Style="{StaticResource CardHero}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Anillo de estado -->
                        <Grid Grid.Column="0" Width="92" Height="92" VerticalAlignment="Center">
                            <Ellipse x:Name="ringGlow" Width="92" Height="92" Opacity="0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#5534D399" Offset="0.4" />
                                        <GradientStop Color="#0034D399" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="ring" Stroke="{StaticResource StrokeBrush}" StrokeThickness="4" />
                            <Ellipse Width="60" Height="60" Fill="{StaticResource TileGlass}" />
                            <Ellipse x:Name="statusDot" Width="22" Height="22" Fill="{StaticResource TextMutedBrush}" />
                        </Grid>

                        <!-- Texto de estado + acciones -->
                        <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="lblStatusTitle" Style="{StaticResource H1}" FontSize="23" Text="Mando desconectado" />
                            <TextBlock x:Name="lblStatusSub" Style="{StaticResource Muted}" Margin="0,3,0,0"
                                       Text="Conéctalo para empezar a rodar." />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="btnRide" Style="{StaticResource PrimaryButtonLarge}" Content="🚴  Empezar a rodar" Click="Ride_Click" />
                                <Button x:Name="btnConnect" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Content="Solo conectar" Click="Go_Click" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Etiqueta "en vivo" -->
                        <Border Grid.Column="2" Style="{StaticResource ChipMuted}" VerticalAlignment="Top" Margin="8,0,0,0" Padding="11,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="liveDot" Width="7" Height="7" Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="lblLive" Text="en reposo" Style="{StaticResource Muted}" FontSize="11" Margin="7,0,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Mando Click V2 en vivo -->
                    <c:ClickDeck x:Name="deck" Height="248" Margin="0,20,0,2" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Text="Tu Click V2 — cada botón se ilumina al pulsarlo." />
                </StackPanel>
            </Border>

            <!-- Tiles de un vistazo -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileLabel}" Text="🎮  MANDO" />
                        <TextBlock x:Name="lblTileDevice" Style="{StaticResource TileValue}" Text="Zwift" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileLabel}" Text="⌨  PRESET DE BOTONES" />
                        <TextBlock x:Name="lblTilePreset" Style="{StaticResource TileValue}" Text="MyWhoosh completo" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileLabel}" Text="🚀  MYWHOOSH" />
                        <TextBlock x:Name="lblTileMyWhoosh" Style="{StaticResource TileValue}" Text="Sin configurar" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tus botones -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="TUS BOTONES" />
                    <WrapPanel x:Name="spButtonsChips" Margin="0,4,0,0" />
                    <TextBlock x:Name="lblButtonsHint" Style="{StaticResource Muted}" FontSize="11.5" Margin="2,2,0,0"
                               Text="Vienen listos para MyWhoosh (precalibrados para el Click V2). Cambia el preset en «Conectar mando»." />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="4" Style="{StaticResource Muted}" Margin="4,16,0,0"
                       Text="Gratis, libre y para siempre · para uso personal con hardware que posees." />
        </Grid>
    </ScrollViewer>
</UserControl>
