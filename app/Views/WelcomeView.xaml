<UserControl x:Class="Violeta.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Violeta.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="44,38,44,38" MaxWidth="880" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Saludo -->
            <StackPanel Grid.Row="0" Margin="2,0,0,16">
                <TextBlock Style="{StaticResource Muted}" Text="Bienvenida de vuelta" />
                <TextBlock Style="{StaticResource Display}" FontSize="30" Text="Tu mando, listo para rodar." />
            </StackPanel>

            <!-- Héroe: estado del mando + acción protagonista -->
            <Border Grid.Row="1" Style="{StaticResource CardHero}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Anillo de estado -->
                    <Grid Grid.Column="0" Width="88" Height="88" VerticalAlignment="Center">
                        <Ellipse x:Name="ring" Stroke="{StaticResource StrokeBrush}" StrokeThickness="4" />
                        <Ellipse Width="58" Height="58" Fill="{StaticResource TileBrush}" />
                        <Ellipse x:Name="statusDot" Width="20" Height="20" Fill="{StaticResource TextMutedBrush}" />
                    </Grid>

                    <!-- Texto de estado -->
                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="lblStatusTitle" Style="{StaticResource H1}" FontSize="22" Text="Mando desconectado" />
                        <TextBlock x:Name="lblStatusSub" Style="{StaticResource Muted}" Margin="0,3,0,0"
                                   Text="Conéctalo para empezar a rodar." />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="btnRide" Style="{StaticResource PrimaryButtonLarge}" Content="🚴  Empezar a rodar" Click="Ride_Click" />
                            <Button x:Name="btnConnect" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Content="Solo conectar" Click="Go_Click" />
                        </StackPanel>
                    </StackPanel>

                    <c:LogoControl Grid.Column="2" Width="150" Height="118" Margin="16,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Tiles de un vistazo -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileLabel}" Text="MANDO" />
                        <TextBlock x:Name="lblTileDevice" Style="{StaticResource TileValue}" Text="Zwift" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileLabel}" Text="PRESET DE BOTONES" />
                        <TextBlock x:Name="lblTilePreset" Style="{StaticResource TileValue}" Text="Cambio de marchas" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileLabel}" Text="MYWHOOSH" />
                        <TextBlock x:Name="lblTileMyWhoosh" Style="{StaticResource TileValue}" Text="Sin configurar" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tus botones -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="TUS BOTONES" />
                    <WrapPanel x:Name="spButtonsChips" Margin="0,4,0,0" />
                    <TextBlock x:Name="lblButtonsHint" Style="{StaticResource Muted}" FontSize="11.5" Margin="2,2,0,0"
                               Text="Vienen listos para MyWhoosh (precalibrados para el Click V2). Cambia el preset en «Conectar mando»." />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="4" Style="{StaticResource Muted}" Margin="4,16,0,0"
                       Text="Gratis, libre y para siempre · para uso personal con hardware que posees." />
        </Grid>
    </ScrollViewer>
</UserControl>
