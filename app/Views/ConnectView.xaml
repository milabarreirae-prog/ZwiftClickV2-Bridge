<UserControl x:Class="Violeta.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,32,36,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══ Formulario ══ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Conectar tu mando" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                           Text="Inicia sesión con tu cuenta (solo para confirmar que el mando es tuyo), pulsa conectar y deja que Violeta haga el resto." />

                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="MODO DE ACCESO" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="rbUserPass" Foreground="{StaticResource TextBrush}" IsChecked="True"
                                         Content="Cuenta" Margin="0,0,16,0" Checked="Mode_Changed" />
                            <RadioButton x:Name="rbToken" Foreground="{StaticResource TextBrush}"
                                         Content="Token" Margin="0,0,16,0" Checked="Mode_Changed" />
                            <RadioButton x:Name="rbDiag" Foreground="{StaticResource TextBrush}"
                                         Content="Solo probar mando" Checked="Mode_Changed" />
                        </StackPanel>

                        <!-- Usuario + contraseña -->
                        <StackPanel x:Name="pnlUserPass" Margin="0,18,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="CORREO DE TU CUENTA" />
                            <TextBox x:Name="txtUser" />
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="2,14,0,6" Text="CONTRASEÑA" />
                            <PasswordBox x:Name="pwd" />
                        </StackPanel>

                        <!-- Token -->
                        <StackPanel x:Name="pnlToken" Margin="0,18,0,0" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="TOKEN" />
                            <TextBox x:Name="txtToken" />
                            <CheckBox x:Name="chkAccess" Foreground="{StaticResource TextMutedBrush}" Margin="2,10,0,0"
                                      Content="Es un access token ya válido (si no, se trata como refresh token)" />
                        </StackPanel>

                        <Border Background="#22000000" CornerRadius="10" Padding="12" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource Muted}" FontSize="12"
                                       Text="🔒 Tus credenciales solo se usan en memoria para iniciar sesión con tu cuenta. Nunca se guardan ni se envían a ningún sitio que no sea el inicio de sesión oficial de tu cuenta." />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Mapeo de botones -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="QUÉ HACEN LOS BOTONES + / −" />
                        <ComboBox x:Name="cmbMapping" Margin="0,2,0,0" SelectedIndex="0">
                            <ComboBoxItem Content="Cambio de marchas — MyWoosh  (+ sube · − baja)" Tag="gears" />
                            <ComboBoxItem Content="Flechas  (+ → · − ←)" Tag="arrows" />
                            <ComboBoxItem Content="Dirección  (+ D · − A)" Tag="steer" />
                        </ComboBox>
                        <CheckBox x:Name="chkSwap" Foreground="{StaticResource TextBrush}" Margin="2,12,0,0"
                                  Content="Invertir + y −  (márcalo si salen al revés)" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="2,8,0,0"
                                   Text="En MyWoosh: I sube de marcha y K baja. Como aún no está confirmado en hardware qué botón es +, si te salen cambiados activa «Invertir»." />
                    </StackPanel>
                </Border>

                <!-- Opciones avanzadas -->
                <Expander Margin="0,14,0,0" Foreground="{StaticResource LilacBrush}" Header="Opciones avanzadas">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="NOMBRE BLUETOOTH DEL MANDO" />
                        <TextBox x:Name="txtDevice" Text="Zwift" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="2,6,0,0"
                                   Text="Buscamos cualquier mando cuyo nombre contenga este texto. «Zwift» reconoce Click, Play y Ride. Afínalo si tienes varios." />
                        <CheckBox x:Name="chkKeyboard" Foreground="{StaticResource TextBrush}" Margin="2,14,0,0" IsChecked="True"
                                  Content="Emular teclado (recomendado)" />
                    </StackPanel>
                </Expander>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="btnStart" Style="{StaticResource PrimaryButton}" Content="🚴  Conectar y desbloquear" Click="Start_Click" />
                    <Button x:Name="btnStop" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Content="Detener" IsEnabled="False" Click="Stop_Click" />
                </StackPanel>

                <TextBlock x:Name="lblStatus" Style="{StaticResource Body}" Margin="2,16,0,0"
                           Foreground="{StaticResource LilacSoftBrush}"
                           Text="Listo para conectar." />
            </StackPanel>
        </ScrollViewer>

        <!-- ══ En vivo ══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource H2}" Text="En vivo · qué está pasando" />

            <!-- Pasos (se construyen desde código) -->
            <StackPanel x:Name="spSteps" Grid.Row="1" Margin="0,12,0,0" />

            <!-- Indicador de botón -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="16" Background="{StaticResource SurfaceHiBrush}">
                        <TextBlock x:Name="lblLastButton" Text="–" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource LilacBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource H2}" Text="Último botón" />
                        <TextBlock x:Name="lblCount" Style="{StaticResource Muted}" Text="Aún no se ha pulsado ningún botón." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Calibración de botones -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource Muted}" FontWeight="SemiBold" Text="CALIBRAR BOTONES" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,8"
                               Text="Pulsa «Calibrar +» y, cuando se te pida, aprieta varias veces el botón que quieres para SUBIR de marcha. Repite con «Calibrar −» para BAJAR." />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnCalPlus" Style="{StaticResource GhostButton}" Padding="14,8" Content="Calibrar +" IsEnabled="False" Click="CalPlus_Click" />
                        <Button x:Name="btnCalMinus" Style="{StaticResource GhostButton}" Padding="14,8" Margin="8,0,0,0" Content="Calibrar −" IsEnabled="False" Click="CalMinus_Click" />
                        <Button x:Name="btnCopyLog" Style="{StaticResource GhostButton}" Padding="14,8" Margin="8,0,0,0" Content="Copiar registro" Click="CopyLog_Click" />
                    </StackPanel>
                    <TextBlock x:Name="lblCal" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,8,0,0"
                               Text="+ : sin calibrar   ·   − : sin calibrar" />
                </StackPanel>
            </Border>

            <!-- Registro -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,0,0,8" Text="REGISTRO" />
                    <ScrollViewer x:Name="scLog" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="spLog" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
