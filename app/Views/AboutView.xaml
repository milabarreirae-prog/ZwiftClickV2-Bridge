<UserControl x:Class="Violeta.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Violeta.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,40,44,40" MaxWidth="800" HorizontalAlignment="Left">

            <!-- Cabecera -->
            <Border Style="{StaticResource Card}" Padding="32">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <c:LogoControl Width="76" Height="60" />
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Display}" FontSize="30" Text="Violeta" />
                            <TextBlock Style="{StaticResource Muted}" Text="Puente para tu mando de ciclismo indoor · versión 1.0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource FreeBadge}" Margin="0,22,0,0" Padding="16,9">
                        <TextBlock Foreground="{StaticResource SuccessBrush}" FontSize="15" FontWeight="Bold"
                                   Text="● Gratis, libre y para siempre" />
                    </Border>
                    <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0" Foreground="{StaticResource LilacSoftBrush}"
                               Text="Sin precio, sin suscripciones, sin anuncios y sin letra pequeña. Si esta app te ayuda a rodar, compártela: nunca te cobraremos por ella." />
                </StackPanel>
            </Border>

            <!-- Autoría -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <Border Height="6" CornerRadius="3" Background="{StaticResource TransRibbonGradient}" Margin="0,0,0,16" />
                    <TextBlock Style="{StaticResource H1}" Text="Hecha por una mujer trans 🏳️‍⚧️" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" Foreground="{StaticResource LilacSoftBrush}"
                               Text="Violeta nació en las manos de una mujer trans que quería rodar con libertad y compartir esa libertad con todo el mundo. Por eso es libre, gratis y cuidada hasta el último detalle: desde el color lila hasta la flor en la cabeza de la ciclista del logo. La tecnología también puede ser nuestra, y puede ser bonita." />
                </StackPanel>
            </Border>

            <!-- Uso responsable -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Uso personal y respetuoso" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Foreground="{StaticResource LilacSoftBrush}"
                               Text="Violeta es una herramienta de interoperabilidad para que uses, con la app que prefieras, un mando que ya posees. Inicia sesión con TU cuenta solo para confirmar que el mando es tuyo; las credenciales viven en memoria y nunca se guardan. No evita pagos ni redistribuye software de terceros." />
                </StackPanel>
            </Border>

            <!-- Créditos + licencia -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="📄 Licencia" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Text="Publicada bajo licencia MIT: puedes usarla, estudiarla, modificarla y compartirla. Software libre de verdad." />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="🙏 Gracias" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Text="A la comunidad de ciclismo indoor de código abierto, cuyo trabajo de documentación hizo posible este puente." />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource Muted}" Margin="4,18,0,0"
                       Text="Proyecto independiente, no afiliado a ninguna marca. Sin garantía de ningún tipo." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
