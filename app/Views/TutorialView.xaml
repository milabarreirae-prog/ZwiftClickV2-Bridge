<UserControl x:Class="Violeta.Views.TutorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,40,44,40" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource Display}" Text="Cómo funciona, en cristiano" />
            <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0" Foreground="{StaticResource LilacSoftBrush}"
                       Text="Todo esto ocurre solo, en un par de segundos, cuando pulsas «Conectar». Aquí te lo contamos paso a paso para que sepas exactamente qué hace tu PC con tu mando y con tu cuenta. Mientras conectas, verás iluminarse cada uno de estos pasos en tiempo real." />

            <!-- Pasos (se rellenan desde código con TutorialSteps.All) -->
            <ItemsControl x:Name="StepsList" Margin="0,24,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                        Background="{StaticResource SurfaceHiBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Glyph}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                    <TextBlock Style="{StaticResource H2}" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                                               Foreground="{StaticResource LilacSoftBrush}" Text="{Binding Detail}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Background="{StaticResource SurfaceHiBrush}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="🔐 Una nota sobre tu cuenta" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Foreground="{StaticResource LilacSoftBrush}"
                               Text="El paso 4 necesita iniciar sesión con TU cuenta solo para confirmar que el mando es tuyo. La app nunca incrusta credenciales ni las guarda en disco: las usa en memoria, en el momento, y las olvida al cerrarse." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
